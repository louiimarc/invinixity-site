<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.invinixity.playspace</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/louism/PlaySpace/server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/louism/PlaySpace</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PLAYSPACE_PORT</key>
        <string>8443</string>
        <key>PLAYSPACE_TLS_CERT</key>
        <string>/Users/louism/Library/Application Support/PlaySpace/tls/playspace.local.pem</string>
        <key>PLAYSPACE_TLS_KEY</key>
        <string>/Users/louism/Library/Application Support/PlaySpace/tls/playspace.local-key.pem</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/louism/Library/Logs/PlaySpace/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/louism/Library/Logs/PlaySpace/server-error.log</string>
</dict>
</plist>
